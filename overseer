def cmd_open(rest):
    token = rest.strip()
    if not token:
        return ["try: /open <name-or-number> -- /list to see what's available"]
    name = resolve(token)
    if name is None:
        return ["no command called '%s' -- /list to see what's available" % token]
    subprocess.run([name])
    return []


def cmd_newsession(rest):
    """Same RUN_COMMAND call opensession makes from plain shell, and
    open_session.py makes from termux-link -- three doors onto the same
    one mechanism, on purpose, rather than picking just one place it's
    allowed to live."""
    command_line = rest.strip()
    if not command_line:
        return ["try: /newsession <command...> -- e.g. /newsession spark"]
    cmd = [
        "am", "startservice", "--user", "0",
        "-n", "com.termux/com.termux.app.RunCommandService",
        "-a", "com.termux.RUN_COMMAND",
        "--es", "com.termux.RUN_COMMAND_PATH", "/data/data/com.termux/files/usr/bin/bash",
        "--esa", "com.termux.RUN_COMMAND_ARGUMENTS", "-c," + command_line,
        "--ez", "com.termux.RUN_COMMAND_BACKGROUND", "false",
    ]
    try:
        subprocess.run(cmd, check=True, capture_output=True, text=True)
    except FileNotFoundError:
        return ["'am' not found -- this only works inside real Termux"]
    except subprocess.CalledProcessError as e:
        return ["couldn't open a new session: " + (e.stderr or str(e)).strip()]
    return ["opened a new session running: " + command_line]


def _proc_mem_mb(pid):
    try:
        with open("/proc/%s/status" % pid) as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return None


def _live_claude_pids():
    try:
        out = subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return [p for p in out.stdout.split() if p]


def cmd_sessions(rest):
    """Lists running `claude` processes -- however they were started,
    the interactive alias in ~/.bashrc or the one Termux:Boot starts
    automatically every reboot -- and lets you close one, by its raw
    pid OR by its position in the list this itself just printed (e.g.
    "2") -- an exact pid match always wins first, so a real pid that
    happens to look small never gets misread as a position. Built after
    three concurrent sessions forced this phone into heavy swap and
    froze Termux (root-caused 2026-09-18); ~/.bashrc's own claude()
    function now warns before starting a new one, this is the other
    half -- closing an EXISTING extra you've already found."""
    rest = rest.strip()
    pids = _live_claude_pids()
    if pids is None:
        return ["pgrep not found"]
    if rest.startswith("kill "):
        token = rest[5:].strip()
        pid = token
        if token not in pids and token.isdigit():
            idx = int(token) - 1
            if 0 <= idx < len(pids):
                pid = pids[idx]
        if not pid.isdigit():
            return ["try: /sessions kill <pid-or-position>"]
        try:
            os.kill(int(pid), 9)
        except ProcessLookupError:
            return ["no such process: %s -- already gone?" % pid]
        except PermissionError:
            return ["no permission to close %s" % pid]
        return ["closed %s -- not lost, `claude --continue` picks it back up" % pid]
    if not pids:
        return ["no claude sessions found running"]
    lines = ["%d claude session%s running:" % (len(pids), "" if len(pids) == 1 else "s")]
    for i, pid in enumerate(pids, 1):
        mb = _proc_mem_mb(pid)
        lines.append("  %d. pid %s%s" % (i, pid, "  (%dMB)" % mb if mb else ""))
    if len(pids) > 1:
        lines.append("more than one at once is what caused the last freeze --")
        lines.append("close extras with: /sessions kill <pid-or-position>")
    return lines


def cmd_updates(rest):
    """/updates (check every repo in updates_lib.REPOS) or
    /updates pull <name|all>. Same logic the menu's "Check for
    updates" screen uses -- see updates_lib.py's own docstring for why
    nothing here runs except when this is actually typed/opened."""
    rest = rest.strip()
    if rest.startswith("pull "):
        target = rest[5:].strip()
        if target == "all":
            return updates_lib.pull_all(updates_lib.check_all())
        if not target:
            return ["try: /updates pull <name-or-all>"]
        return updates_lib.pull_one(target)
    return updates_lib.format_report(updates_lib.check_all())


def cmd_feed(rest):
    """/feed [--days N] [--part NAME] -- same report the menu's "Live
    feed" screen shows, as a slash command."""
    args = [sys.executable, os.path.join(os.path.dirname(SELF), "feed")] + rest.split()
    result = subprocess.run(args, capture_output=True, text=True)
    return (result.stdout + result.stderr).splitlines()


def run_command(said):
    said = said.strip()
    if not said or said == "/":
        said = "/help"
    elif said.lstrip("/").isdigit():
        said = "/open " + said.lstrip("/")
    word, _, rest = said.lstrip("/").partition(" ")
    if word == "help":
        return HELP
    if word == "wakeup":
        return wakeup_lines()
    if word == "list":
        return format_list()
    if word == "open":
        return cmd_open(rest)
    if word == "newsession":
        return cmd_newsession(rest)
    if word == "sessions":
        return cmd_sessions(rest)
    if word == "updates":
        return cmd_updates(rest)
    if word == "feed":
        return cmd_feed(rest)
    # Anything else: if it's a real command on PATH, just run it --
    # "spark" launches spark the same way typing it at an ordinary
    # shell prompt would, whether or not it's # CATALOG:-tagged (that
    # tag only controls whether /list shows it, not whether this can
    # run it -- deliberately more permissive than resolve()/cmd_open).
    if shutil.which(word):
        subprocess.run([word] + rest.split())
        return []
    return ["no such command: /%s -- /help to see what's available" % word]


TERMUX_HOME = "/data/data/com.termux/files/home"
VOICE_STATE = TERMUX_HOME + "/.termux-voice/state"
MEMGUARD = TERMUX_HOME + "/bin/memguard.sh"
# claude-sync's repo as seen from plain Termux (the Ubuntu container's
# /root/.claude) -- read locally only, never fetched, same no-silent-
# network rule updates_lib follows.
SYNC_REPO = ("/data/data/com.termux/files/usr/var/lib/proot-distro/"
             "containers/ubuntu/rootfs/root/.claude")
LOW_MB = 300  # same threshold memguard.sh warns at


def _free_mb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return None


def _running(pattern):
    try:
        out = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
    except FileNotFoundError:
        return False
    return bool(out.stdout.strip())


def _sync_status():
    if not os.path.isdir(os.path.join(SYNC_REPO, ".git")):
        return "not set up on this phone"
    def g(*args):
        try:
            out = subprocess.run(["git", "-c", "safe.directory=*", "-C", SYNC_REPO] + list(args),
                                 capture_output=True, text=True, timeout=15)
            return out.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return ""
    last = g("log", "-1", "--format=%cr") or "?"
    ahead = g("rev-list", "--count", "@{u}..HEAD")
    dirty = g("status", "--porcelain")
    pending = (ahead not in ("", "0")) or bool(dirty)
    return "last commit %s%s" % (last, "  <- not pushed yet (wake up > sync)" if pending else "")


def wakeup_lines():
    """The status board -- everything here is read locally, nothing
    touches the network, so opening it is always instant and free."""
    pids = _live_claude_pids() or []
    free = _free_mb()
    if not pids:
        claude = "not running"
    else:
        claude = "%d running" % len(pids)
        if len(pids) > 1:
            claude += "  <- close extras (menu 2)"
    if free is None:
        mem = "unknown"
    else:
        mem = "%dMB free%s" % (free, "  <- low" if free < LOW_MB else "")
    try:
        with open(VOICE_STATE) as f:
            voice = f.read().strip() or "?"
    except OSError:
        voice = "not set up"
    return [
        time.strftime("%a %d %b  %H:%M"),
        "claude    " + claude,
        "memory    " + mem,
        "memguard  " + ("watching" if _running("memguard.sh") else "not running"),
        "voice     " + voice,
        "sync      " + _sync_status(),
    ]


def _in_ubuntu(*cmd):
    """Runs a command inside the Ubuntu container from plain Termux."""
    if not shutil.which("proot-distro"):
        return ["proot-distro not found -- run overseer from plain Termux, not inside Ubuntu"]
    subprocess.run(["proot-distro", "login", "ubuntu", "--"] + list(cmd))
    return []


def _menu_wakeup():
    options = [
        ("Continue Claude (new session)", "claude"),
        ("Sync Claude chats now", "sync"),
        ("Check for updates", "updates"),
    ]
    while True:
        print("\n".join(wakeup_lines()))
        action, raw = _menu_screen("Wake up", options, has_parent=True)
        if action == babymenu.BACK:
            return
        if action == "claude":
            if _live_claude_pids():
                print("claude is already running -- one at a time (menu 2 to close extras)")
            else:
                for line in cmd_newsession("proot-distro login ubuntu -- cl"):
                    print(line)
        elif action == "sync":
            for line in _in_ubuntu("csync", "push"):
                print(line)
        elif action == "updates":
            _menu_updates()
        elif raw.strip():
            for line in run_command(raw):
                print(line)


def read_state(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def boot():
    """Termux:Boot entry point -- start-claude.sh only hands off to this.
    The steps that script always ran, plus wake's check-in reminders."""
    # 1. the boot-time claude tmux session inside Ubuntu
    _in_ubuntu("/root/bin/claude-session.sh")
    # 2. voice starts off -- ~/.termux-voice/toggle.sh turns it on
    try:
        os.makedirs(os.path.dirname(VOICE_STATE), exist_ok=True)
        with open(VOICE_STATE, "w") as f:
            f.write("off\n")
    except OSError:
        pass
    # 3. wake's 20-min check-in job, if it was on (persisted jobs usually
    #    survive a reboot already; this makes sure)
    if read_state(os.path.join(TERMUX_HOME, ".wake", "remind")) == "on":
        subprocess.run([sys.executable, os.path.join(os.path.dirname(SELF), "wake"), "remind", "on"],
                       stdin=subprocess.DEVNULL, capture_output=True, timeout=60)
    # 4. memguard, detached so it outlives this process; skipped if one
    #    is already watching (re-running boot by hand shouldn't stack two)
    if os.path.exists(MEMGUARD) and not _running("memguard.sh"):
        log = open(os.path.join(TERMUX_HOME, ".memguard.log"), "a")
        subprocess.Popen([MEMGUARD], stdout=log, stderr=log,
                         stdin=subprocess.DEVNULL, start_new_session=True)


NOTIFY_ID = "overseer"


SELF = os.path.abspath(__file__)


def notify_post(content=None):
    try:
        subprocess.run([
            "termux-notification", "--id", NOTIFY_ID,
            "--title", "overseer",
            "--content", (content or "type a command below")[:2000],
            "--button1", "Reply",
            # This $REPLY is deliberately NOT expanded here -- Termux:API's
            # own notification system substitutes the typed reply text
            # into it before running the action, same trick ~/bin/ti.sh
            # already uses for its own Reply button. Matched against
            # ti.sh's own working shape as closely as possible: the full
            # absolute path (not the bare `overseer` command, which needs
            # PATH set up -- ti.sh's $SELF is absolute for the same
            # reason) and no quotes around $REPLY (ti.sh has none either).
            "--button1-action", "%s notify --reply $REPLY" % SELF,
            "--ongoing",
        ], check=True)
    except FileNotFoundError:
        print("termux-notification not found -- needs Termux:API "
              "(pkg install termux-api, plus the Termux:API app)")
    except subprocess.CalledProcessError as e:
        print("couldn't post the notification: " + str(e))


def notify_reply(text):
    lines = run_command(text)
    notify_post("\n".join(lines) if lines else "(no output)")


def notify_stop():
    try:
        subprocess.run(["termux-notification-remove", "--id", NOTIFY_ID], check=True)
    except FileNotFoundError:
        print("termux-notification-remove not found -- needs Termux:API")
    except subprocess.CalledProcessError as e:
        print("couldn't remove it: " + str(e))


def _menu_screen(title, options, has_parent, page=0):
    """Prints one babymenu screen and reads one line. Returns (action,
    raw_text) -- action is a value from `options`, or babymenu's own
    BACK/EXIT/MORE, or None if what was typed wasn't a valid digit (in
    which case raw_text is handed back so the caller can still try it
    as an ordinary /slash command -- typing /help or /quit still works
    everywhere, this menu is the new default view, not a replacement
    that breaks muscle memory).

    "a" (babymenu.ALL_KEY) is handled right here, generically, so every
    screen that goes through this function gets "show all" for free --
    prints the full un-paginated list and redraws the very same screen
    rather than treating "a" as a command or a wrong digit."""
    while True:
        lines, keymap = babymenu.render(title, options, page=page, has_parent=has_parent)
        print("\n".join(lines))
        try:
            said = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return (babymenu.EXIT if not has_parent else babymenu.BACK), ""
        if said.lower() == babymenu.ALL_KEY:
            print("\n".join(babymenu.format_all(options)))
            continue
        return keymap.get(said), said


def _menu_open_command():
    page = 0
    while True:
        options = [(desc, name) for name, desc in discover()]
        action, raw = _menu_screen("Open which command?", options, has_parent=True, page=page)
        if action == babymenu.BACK:
            return
        if action == babymenu.MORE:
            page += 1
            continue
        if action is not None:
            subprocess.run([action])
            return
        if raw.strip():
            for line in run_command(raw):
                print(line)


def _menu_sessions():
    page = 0
    while True:
        out = subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True)
        pids = [p for p in out.stdout.split() if p]
        options = []
        for pid in pids:
            mb = _proc_mem_mb(pid)
            options.append(("close pid %s%s" % (pid, "  (%dMB)" % mb if mb else ""), pid))
        action, raw = _menu_screen("Claude sessions", options, has_parent=True, page=page)
        if action == babymenu.BACK:
            return
        if action == babymenu.MORE:
            page += 1
            continue
        if action is not None:
            try:
                os.kill(int(action), 9)
                print("closed %s -- claude --continue picks it back up later" % action)
            except ProcessLookupError:
                print("already gone")
            return
        if raw.strip():
            for line in run_command(raw):
                print(line)


def _menu_feed():
    """Runs `feed` and shows its output. A plain subprocess call, not an
    import -- feed is a standalone read-only report with nothing to act
    on afterward (unlike updates, which can also offer a pull)."""
    subprocess.run([sys.executable, os.path.join(os.path.dirname(SELF), "feed")])
    input("\n(enter to go back) ")


def _menu_updates():
    """Fetch + report every repo in updates_lib.REPOS, then offer to pull
    whichever ones are behind. The fetch only happens because this screen
    was actually opened -- see updates_lib's own docstring for why that
    matters on a phone."""
    print("checking GitHub...")
    results = updates_lib.check_all()
    print("\n".join(updates_lib.format_report(results)))
    behind = [name for name, status in results.items()
              if status.get("ok") and status.get("behind", 0) > 0]
    if not behind:
        input("\n(enter to go back) ")
        return
    options = [("Pull %s" % name, name) for name in behind]
    if len(behind) > 1:
        options.append(("Pull all", "all"))
    while True:
        action, raw = _menu_screen("Pull which update?", options, has_parent=True)
        if action == babymenu.BACK:
            return
        if action == babymenu.MORE:
            continue
        if action == "all":
            print("\n".join(updates_lib.pull_all(results)))
            return
        if action is not None:
            print("\n".join(updates_lib.pull_one(action)))
            return
        if raw.strip():
            for line in run_command(raw):
                print(line)


def _menu_notify():
    options = [("Post it", "post"), ("Take it down", "stop")]
    action, _ = _menu_screen("Pinned notification", options, has_parent=True)
    if action == "post":
        notify_post()
        print("posted")
    elif action == "stop":
        notify_stop()
        print("removed")


def _menu_top():
    options = [
        ("Wake up", "wakeup"),
        ("Claude sessions (close extras)", "sessions"),
        ("Open a command", "open"),
        ("Open one in a new session", "newsession"),
        ("Check for updates", "updates"),
        ("Live feed (git, RAM, sync, more)", "feed"),
        ("Pinned notification", "notify"),
    ]
    while True:
        pids = _live_claude_pids() or []
        free = _free_mb()
        title = "overseer -- claude %s%s" % (
            "x%d" % len(pids) if pids else "off",
            ", %dMB free" % free if free is not None else "")
        action, raw = _menu_screen(title, options, has_parent=False)
        if action == babymenu.EXIT:
            return
        elif action == "wakeup":
            subprocess.run([sys.executable, os.path.join(os.path.dirname(SELF), "wake")])
        elif action == "sessions":
            _menu_sessions()
        elif action == "open":
            _menu_open_command()
        elif action == "newsession":
            cmdline = input("command to run in a new session: ").strip()
            if cmdline:
                for line in cmd_newsession(cmdline):
                    print(line)
        elif action == "updates":
            _menu_updates()
        elif action == "feed":
            _menu_feed()
        elif action == "notify":
            _menu_notify()
        elif raw.strip():
            word = raw.strip().lstrip("/").split(None, 1)[0].lower()
            if word in ("quit", "q"):
                return
            for line in run_command(raw):
                print(line)


def run():
    _menu_top()
    print("bye")


if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "boot":
        boot()
    elif len(sys.argv) >= 2 and sys.argv[1] == "wakeup":
        print("\n".join(wakeup_lines()))
    elif len(sys.argv) >= 2 and sys.argv[1] == "notify":
        if len(sys.argv) >= 3 and sys.argv[2] == "--reply":
            notify_reply(" ".join(sys.argv[3:]))
        elif len(sys.argv) >= 3 and sys.argv[2] == "--stop":
            notify_stop()
        else:
            notify_post()
    else:
        run()
