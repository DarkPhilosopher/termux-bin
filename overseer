import babymenu  # noqa: E402 -- shared numbered-menu pattern, see its own docstring
from catalog_lib import format_list, resolve, discover  # noqa: E402 -- shared with `programs`
import updates_lib  # noqa: E402 -- shared with the bare `updates` command

